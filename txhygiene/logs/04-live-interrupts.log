== 3. continuity so far: every ledger start_seq..last exactly once, no duplicate tx, txn_count == lines
$ python3 -c 'import json
L=[json.loads(l) for l in open("data/txhygiene/tx/ledgers.jsonl")]
T=[json.loads(l) for l in open("data/txhygiene/tx/tx.jsonl")]
s=json.load(open("data/txhygiene/tx/state.json"))["start_seq"]
idx=[r["ledger_index"] for r in L]
print("ledgers", len(idx), idx[0], idx[-1], "contiguous", idx==list(range(s, idx[-1]+1)))
print("tx lines", len(T), "unique hashes", len({t["tx_hash"] for t in T}), "txn_count sum", sum(r["txn_count"] for r in L))
print("tx after last ledger", sum(t["ledger_index"]>idx[-1] for t in T))
assert idx==list(range(s, idx[-1]+1)) and len(T)==len({t["tx_hash"] for t in T})'
