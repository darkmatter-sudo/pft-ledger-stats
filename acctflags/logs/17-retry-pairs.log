## verification-check script used above (pairs.py, read-only over the pinned data files)
import json, sys
txs = [json.loads(l) for l in open(sys.argv[1])]
led = {json.loads(l)["ledger_index"] for l in open(sys.argv[2])}
pays = [t for t in txs if t["type"] == "Payment"]
ok = [t for t in pays if t["result"] == "tesSUCCESS"]
for t in pays:
    if t["result"] == "tesSUCCESS":
        continue
    k = (t["ledger_index"], t["tx_index"])
    later = [p for p in ok if p["sender"] == t["sender"] and p["destination"] == t["destination"] and (p["ledger_index"], p["tx_index"]) > k]
    if not later:
        continue
    r = min(later, key=lambda p: (p["ledger_index"], p["tx_index"]))
    gap = sum(1 for i in range(k[0] + 1, r["ledger_index"] + 1) if i not in led)
    el = r["ledger_index"] - k[0]
    print(f"fail ledger={k[0]} tx={k[1]} {t['result']} sender={t['sender']} dest={t['destination']} -> retry ledger={r['ledger_index']} tx={r['tx_index']} elapsed={el} missing_ledgers_between={gap} in_w100={el <= 100} in_w90={el <= 90}")
